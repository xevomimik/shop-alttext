{
  "compilerOptions": {
    "target": "ES5",
    "lib": "DOM",
    "module": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esVersion": "es2021",
    "moduleResolution": "node",
    "jsx": "preserve",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/app/*": ["./src/app/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".next", "dist"]
}